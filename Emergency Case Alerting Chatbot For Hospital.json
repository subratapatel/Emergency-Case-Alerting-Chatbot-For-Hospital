    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Add a new field called 'myNewField' to the JSON of the item\nconst rawInput = $json.body.userInput || \"\"\n\n//Normalize\nconst input = rawInput\n  .toLowerCase()\n  .replace(/[^a-z0-9\\s]/g, \"\")\n  .replace(/\\s+/g, \" \")\n  .trim();\n\n//chest pain\nconst hasChestPain = \n  input.includes(\"chest\") && input.includes(\"pain\");\n\n//Breathing\nconst breathingKeywords = [\n  \"cant breathe\",\n  \"cannot breathe\",\n  \"breathing difficulty\",\n  \"shortness of breath\",\n  \"breathness\",\n  \"shortness of breath\",\n  \"breathless\",\n  \"not able to breathe\",\n  \"unable to breathe\"\n  ];\n\nconst hasBreathingIssues = breathingKeywords.some(k => \n  input.includes(k)\n);\n\nconst isEmergency = hasChestPain || hasBreathingIssues;\n\nlet queryType = \"general\";\nif (input.includes(\"pain\") || input.includes(\"fever\")) {\n  queryType=\"symptom\";\n}\n\nreturn {\n  $json,\n  debug_input: input,\n  isEmergency,\n  queryType,\n  language: $json.body?.language || \"en\",\n  name: $json.body?.name,\n  contact: $json.body?.contact\n};\n\n  \n\n"
      },
